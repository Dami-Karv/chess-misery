DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Optional but recommended while testing. If set, commands update instantly in one server.
DISCORD_GUILD_ID=your_test_server_id_here

# Chess.com asks API clients to include contact info in User-Agent.
CHESS_COM_USER_AGENT=chessmisery/1.0 (discord: your_discord_username)

# Polling and analysis tuning.
POLL_SECONDS=120
ANALYSIS_DEPTH=14
BLUNDER_THRESHOLD_CP=200
MAX_ANALYZED_PLIES=120
HEALTH_SERVER_ENABLED=true

# Optional overrides.
# REDIS_KEY=chessmisery:db
# DATABASE_PATH=./data/db.json
# STOCKFISH_PATH=./vendor/stockfish/stockfish-18-lite-single.js
